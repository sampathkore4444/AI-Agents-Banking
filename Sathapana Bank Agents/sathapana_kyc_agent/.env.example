# Sathapana Bank KYC Agent — example environment configuration.
# Copy to `.env` (in the agent folder) and set real values for production.
# `security/crypto.py` bootstraps the KYC_* key values automatically if absent.

# --- Runtime environment ---
KYC_ENV=development              # development | staging | production

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Vector store / embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2  # or paraphrase-multilingual-MiniLM-L12-v2 for Khmer
VECTOR_BACKEND=numpy              # numpy (default) | chromadb (needs `pip install chromadb`)
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K=5

# --- Database ---
DB_PATH=./data/sathapana_kyc.db

# --- Provider adapters: stub (deterministic/offline) | http (live API) ---
SANCTIONS_PROVIDER=stub
IDENTITY_PROVIDER=stub
OCR_PROVIDER=stub
NOTIFICATION_PROVIDER=stub
BAKONG_PROVIDER=stub
CAMFIU_PROVIDER=stub

# --- Vendor endpoints / credentials (production) ---
NBC_BAKONG_API_URL=https://bakong-api.nbc.gov.kh
SANCTIONS_API_URL=
SANCTIONS_API_TOKEN=
IDENTITY_API_URL=
IDENTITY_API_TOKEN=
OCR_API_URL=
OCR_API_TOKEN=
NOTIFICATION_API_URL=
NOTIFICATION_API_TOKEN=
CAMFIU_API_URL=
CAMFIU_API_TOKEN=
CAMFIU_REPORTING_URL=https://report.camfiu.gov.kh

VENDOR_TIMEOUT_SECONDS=10.0
VENDOR_MAX_RETRIES=2

# --- Cryptography (generated automatically if empty; do not commit real keys) ---
KYC_ENCRYPTION_KEY=
TOKENIZATION_KEY=
HASH_CHAIN_SALT=

# --- MCP server ---
MCP_TRANSPORT=stdio               # stdio | tcp
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TLS_CERT=
MCP_TLS_KEY=
# MCP_AUTH_TOKEN=                # set a bearer token to require auth
# MCP_RATE_LIMIT_RPM=600
# MCP_MAX_PAYLOAD_BYTES=262144

# --- Approval / HITL workflow ---
APPROVAL_SLA_SECONDS=300
DEFAULT_OFFICER_ID=MLRO-001

# --- Cambodia-specific KYC rules ---
UBO_DEFAULT_THRESHOLD_PCT=25
UBO_HIGH_RISK_THRESHOLD_PCT=10
DOMESTIC_PEP_REQUIRES_EDD=true
DUPLICATE_CHECK_MATCH_THRESHOLD=0.85
RECORD_RETENTION_YEARS=5