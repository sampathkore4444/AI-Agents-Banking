# ══════════════════════════════════════════════════════════════════
#  Document Digitization & Extraction Agent — Environment Variables
# ══════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The agent loads settings from .env automatically via pydantic-settings.
# All variables are optional — the agent works with sensible defaults.
# Set at least one OCR provider for real document extraction.
#


# ──────────────────────────────────────────────────────────────────
#  LLM (Optional — used by base_agent.py for interactive mode)
# ──────────────────────────────────────────────────────────────────

# OpenAI API key (only needed if using OpenAI models directly)
# OPENAI_API_KEY=sk-...

# Model to use (default: gpt-4o)
# OPENAI_MODEL=gpt-4o


# ──────────────────────────────────────────────────────────────────
#  ChromaDB (Vector Database)
# ──────────────────────────────────────────────────────────────────

# Directory to persist ChromaDB data (default: ./chroma_db)
# CHROMA_PERSIST_DIR=./chroma_db

# Collection name prefix (default: doc_digitization)
# CHROMA_COLLECTION_PREFIX=doc_digitization

# Embedding model for semantic search (default: all-MiniLM-L6-v2)
# Upgrade to text-embedding-3-large for better accuracy in production
# EMBEDDING_MODEL=all-MiniLM-L6-v2


# ──────────────────────────────────────────────────────────────────
#  AWS Textract (OCR Provider #1)
# ──────────────────────────────────────────────────────────────────
#
# Setup:
#   1. Create an AWS account (https://aws.amazon.com)
#   2. Create an IAM user with AmazonTextractFullAccess policy
#   3. Generate access keys
#   4. Set the variables below
#
# Docs: https://docs.aws.amazon.com/textract/latest/dg/what-is.html

# AWS credentials
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# AWS region (default: us-east-1)
# Textract is available in: us-east-1, us-west-2, eu-west-1, eu-west-2,
# eu-central-1, ap-southeast-1, ap-northeast-1, ca-central-1
# AWS_REGION=us-east-1


# ──────────────────────────────────────────────────────────────────
#  Google Cloud Vision (OCR Provider #2)
# ──────────────────────────────────────────────────────────────────
#
# Setup:
#   1. Create a Google Cloud project (https://console.cloud.google.com)
#   2. Enable the Cloud Vision API
#   3. Create a service account with "Cloud Vision Admin" role
#   4. Download the JSON key file
#   5. Set GOOGLE_APPLICATION_CREDENTIALS to the file path
#
# Docs: https://cloud.google.com/vision/docs

# Path to Google Cloud service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google Cloud project ID
# GOOGLE_PROJECT_ID=your-project-id


# ──────────────────────────────────────────────────────────────────
#  OCR Provider Configuration
# ──────────────────────────────────────────────────────────────────
#
# Which OCR provider to use:
#   "textract"     — AWS Textract only
#   "google_vision" — Google Cloud Vision only
#   "auto"         — Textract first, fallback to Google Vision (recommended)

# OCR_PROVIDER=auto

# Minimum OCR confidence score (0.0 - 1.0) for extraction acceptance
# Below this threshold, documents are rejected for re-scanning
# OCR_MIN_CONFIDENCE=0.6


# ──────────────────────────────────────────────────────────────────
#  External APIs (Optional — for production integration)
# ──────────────────────────────────────────────────────────────────

# Notification service URL (email/SMS/in-app notifications)
# NOTIFICATION_API_URL=https://api.notifications.internal

# Document storage URL (S3, GCS, or internal storage)
# DOCUMENT_STORAGE_URL=https://storage.internal/documents

# Database write API URL (for storing extracted data)
# DATABASE_WRITE_API_URL=https://api.database.internal


# ──────────────────────────────────────────────────────────────────
#  OCR Quality Thresholds
# ──────────────────────────────────────────────────────────────────

# Minimum OCR confidence to accept extraction (default: 0.6)
# MIN_OCR_CONFIDENCE=0.6

# High confidence threshold — direct auto-processing (default: 0.85)
# HIGH_CONFIDENCE_THRESHOLD=0.85

# Low confidence threshold — flag for manual review (default: 0.7)
# LOW_CONFIDENCE_THRESHOLD=0.7


# ──────────────────────────────────────────────────────────────────
#  Extraction Limits
# ──────────────────────────────────────────────────────────────────

# Maximum document file size in MB (default: 50)
# MAX_DOCUMENT_SIZE_MB=50

# Maximum pages per document (default: 100)
# MAX_PAGES_PER_DOCUMENT=100

# Extraction timeout in seconds (default: 120)
# EXTRACTION_TIMEOUT_SECONDS=120


# ══════════════════════════════════════════════════════════════════
#  QUICK START EXAMPLES
# ══════════════════════════════════════════════════════════════════
#
# Minimal setup (AWS Textract only):
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   OCR_PROVIDER=textract
#
# Minimal setup (Google Vision only):
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
#   OCR_PROVIDER=google_vision
#
# Production setup (both providers with fallback):
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_REGION=us-east-1
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
#   OCR_PROVIDER=auto
#   MIN_OCR_CONFIDENCE=0.7
#   MAX_DOCUMENT_SIZE_MB=100
#
